# Copy to frontend/.env (git ignores it) when the defaults below do not fit your setup.
# Vite only exposes variables that start with VITE_; they are read when the dev server starts, so restart it after a change.

# Backend API (shop, chat, donations). Must be reachable from the BROWSER, so use localhost, not a docker service name.
VITE_API_URL=http://localhost:8080

# Analytics API (donation statistics).
VITE_ANALYTICS_URL=http://localhost:8000

# Local auth demonstration; real HttpOnly refresh-cookie flow requires the backend.
VITE_AUTH_MOCK=false
