# Copy this file to ".env" (git ignores it) and fill in the key. Never commit a real key.
# Without a key the chat works in demo mode.
# Which AI service answers: openrouter (default) or hive. The key of the selected one is used.
CHAT_PROVIDER=openrouter
OPENROUTER_API_KEY=
# One model, or several separated by commas: the next is used when the previous is overloaded (HTTP 429/5xx).
OPENROUTER_MODEL=deepseek/deepseek-chat
# Reply budget in tokens. Reasoning models spend part of it on thinking: too small = empty answer.
OPENROUTER_MAX_TOKENS=1500
# Reasoning effort for models that think: off | low | medium | high | default (do not send).
OPENROUTER_REASONING=low

# The Hive (used when CHAT_PROVIDER=hive). Same model fallback and error messages as OpenRouter.
HIVE_API_KEY=
# One model, or several separated by commas (tried in order).
HIVE_MODEL=deepseek-ai/deepseek-v4.1-flash
HIVE_BASE_URL=https://api-cdn.thehive.ai/api/v3
HIVE_TIMEOUT_SECONDS=30
# Reply budget in tokens (reasoning models spend part of it on thinking).
HIVE_MAX_TOKENS=1500
# low | medium | high (leave empty to not send it).
HIVE_REASONING_EFFORT=
HIVE_TEMPERATURE=0.4

# Fill an empty shop catalogue (items table) with the demo products on backend start.
SEED_ON_STARTUP=true

# Logging level of backend and analytics: DEBUG, INFO (default), WARNING, ERROR.
LOG_LEVEL=INFO
# Browser origins allowed by CORS, comma-separated (default http://localhost:3000, the frontend).
# "*" is refused by the backend: login keeps its session in a cookie, and browsers forbid "*" with cookies.
CORS_ORIGINS=http://localhost:3000

# Secret that signs login tokens (JWT). REQUIRED: the backend does not start without it.
# At least 32 characters, unique per installation, never committed. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Lifetime of a login token in minutes (1..1440).
JWT_EXPIRE_MINUTES=60
# Lifetime of a login session (the HttpOnly refresh_token cookie) in days (1..365); F5 keeps you logged in.
REFRESH_EXPIRE_DAYS=30
# Send the session cookie over HTTPS only. Browsers treat http://localhost as secure, so keep true locally;
# set false only when the site is opened over plain http on another host name (e.g. a LAN IP).
COOKIE_SECURE=true
